{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\[\\s*$",
    "decreaseIndentPattern": "^\\s*\\]"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_-]*",
  "folding": {
    "markers": {
      "start": "\\[",
      "end": "\\]"
    }
  }
}
